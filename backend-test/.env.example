# AquaIntelX AI Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=5000
API_HOST=0.0.0.0

# Model Configuration
MODEL_PATH=./models/water_anomaly_detector.h5
SCALER_PATH=./models/scaler.pkl
ANOMALY_THRESHOLD=0.7

# Real-time Analysis
ANALYSIS_WINDOW_SIZE=60
REAL_TIME_UPDATE_INTERVAL=5

# Water Quality Thresholds
PH_MIN=6.5
PH_MAX=8.5
DO_MIN=5.0
TURBIDITY_MAX=5.0
TEMPERATURE_MIN=0
TEMPERATURE_MAX=35
